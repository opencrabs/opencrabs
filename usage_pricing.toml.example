  # records; the hyphen forms above stay for older rows.
  { prefix = "qwen3.8-omni-flash",   input_per_m = 0.15,  output_per_m = 0.47,  cache_write_per_m = 0.20, cache_read_per_m = 0.016 },
  { prefix = "qwen-3.8-omni-flash",  input_per_m = 0.15,  output_per_m = 0.47,  cache_write_per_m = 0.20, cache_read_per_m = 0.016 },
  { prefix = "qwen3.8-flash-next",   input_per_m = 0.15,  output_per_m = 0.47,  cache_write_per_m = 0.20, cache_read_per_m = 0.016 },
  # Qwen3.7-Max / Qwen3.7-Plus (Model Studio, Singapore region list).
  { prefix = "qwen3.7-max",          input_per_m = 2.50,  output_per_m = 7.50 },
  { prefix = "qwen-3.7-max",         input_per_m = 2.50,  output_per_m = 7.50 },
  { prefix = "qwen3.7-plus",         input_per_m = 0.40,  output_per_m = 1.60 },
  { prefix = "qwen-3.7-plus",        input_per_m = 0.40,  output_per_m = 1.60 },
  # Qwen 3.6 Max Preview — DashScope tiered pricing (≤128k: $1.3/$7.8, 128k-256k: $2/$12)
  # All variants map here: qwen3.6-max-preview, qwen-3.6-max-preview, qwen-3-6-max-preview, etc.
  { prefix = "qwen-3.6-max-preview",  input_per_m = 1.30,  output_per_m = 7.80,  cache_write_per_m = 1.625, cache_read_per_m = 0.13 },
  { prefix = "qwen3.6-max-preview",   input_per_m = 1.30,  output_per_m = 7.80,  cache_write_per_m = 1.625, cache_read_per_m = 0.13 },
  { prefix = "qwen-3-6-max-preview",  input_per_m = 1.30,  output_per_m = 7.80,  cache_write_per_m = 1.625, cache_read_per_m = 0.13 },
  { prefix = "qwen3-6-max-preview",   input_per_m = 1.30,  output_per_m = 7.80,  cache_write_per_m = 1.625, cache_read_per_m = 0.13 },
  { prefix = "qwen-max-preview",      input_per_m = 1.30,  output_per_m = 7.80,  cache_write_per_m = 1.625, cache_read_per_m = 0.13 },
  # Qwen3.8-Max — GA since 2026-08-03 at $2/$6: ONE flat tier across the whole 1M context,
  # thinking tokens billed as output. Cache: explicit write $2.50/M, reads $0.25/M.
  # The July preview promo cards are gone; any remaining -preview id bills at this GA card,
  # so the -preview rows below were repointed off the old mirrored 1.30/7.80 placeholder.
  { prefix = "qwen-3.8-max",          input_per_m = 2.00,  output_per_m = 6.00,  cache_write_per_m = 2.50,  cache_read_per_m = 0.25 },
  { prefix = "qwen3.8-max",           input_per_m = 2.00,  output_per_m = 6.00,  cache_write_per_m = 2.50,  cache_read_per_m = 0.25 },
  { prefix = "qwen-3-8-max",          input_per_m = 2.00,  output_per_m = 6.00,  cache_write_per_m = 2.50,  cache_read_per_m = 0.25 },
  { prefix = "qwen3-8-max",           input_per_m = 2.00,  output_per_m = 6.00,  cache_write_per_m = 2.50,  cache_read_per_m = 0.25 },
  { prefix = "qwen-3.8-max-preview",  input_per_m = 2.00,  output_per_m = 6.00,  cache_write_per_m = 2.50,  cache_read_per_m = 0.25 },
  { prefix = "qwen3.8-max-preview",   input_per_m = 2.00,  output_per_m = 6.00,  cache_write_per_m = 2.50,  cache_read_per_m = 0.25 },
  { prefix = "qwen-3-8-max-preview",  input_per_m = 2.00,  output_per_m = 6.00,  cache_write_per_m = 2.50,  cache_read_per_m = 0.25 },
  { prefix = "qwen3-8-max-preview",   input_per_m = 2.00,  output_per_m = 6.00,  cache_write_per_m = 2.50,  cache_read_per_m = 0.25 },
  # Qwen3.8-Flash — commercial ship of the Flash-Next open architecture (262k native ctx).
  # QwenCloud API: $0.16/M input, $0.47/M output. Cache rates not published yet.
  { prefix = "qwen-3.8-flash-next",   input_per_m = 0.15,  output_per_m = 0.47,  cache_write_per_m = 0.20, cache_read_per_m = 0.016 },
  { prefix = "qwen-3.8-flash",        input_per_m = 0.15,  output_per_m = 0.47,  cache_write_per_m = 0.20, cache_read_per_m = 0.016 },
  { prefix = "qwen3.8-flash",         input_per_m = 0.15,  output_per_m = 0.47,  cache_write_per_m = 0.20, cache_read_per_m = 0.016 },
  { prefix = "qwen-3-8-flash",        input_per_m = 0.15,  output_per_m = 0.47,  cache_write_per_m = 0.20, cache_read_per_m = 0.016 },
  # Qwen 3.6 Plus (thinking) — DashScope tiered pricing (input ≤256k)
  # Output corrected to $3.0 per DashScope official pricing (was $1.50)
  { prefix = "qwen-3.6-plus",      input_per_m = 0.50,  output_per_m = 3.00,  cache_write_per_m = 0.625, cache_read_per_m = 0.05 },
  { prefix = "qwen3.6-plus",       input_per_m = 0.50,  output_per_m = 3.00,  cache_write_per_m = 0.625, cache_read_per_m = 0.05 },
  { prefix = "qwen-plus",          input_per_m = 0.50,  output_per_m = 3.00,  cache_write_per_m = 0.625, cache_read_per_m = 0.05 },
]

[providers.zai]
entries = [
  # GLM-5.2 and GLM-5.1 (Z.AI list): $1.40/$4.40, cached input $0.26. GLM-5 is $1/$3.20.
  { prefix = "glm-5.2",            input_per_m = 1.40,  output_per_m = 4.40,  cache_read_per_m = 0.26 },
  # ox-alpha was the stealth alias of GLM-5.3-Flash, revealed 2026-08-26.
  { prefix = "ox-alpha",           input_per_m = 0.15,  output_per_m = 0.50,  cache_read_per_m = 0.03 },
  # GLM-5.3-Flash — list prices; a 50% launch promo ($0.075 in / $0.015 cache / $0.25 out)
  # runs until 24:00 2026-09-09 UTC+8. Rows carry list so bills stay right after it expires.
  { prefix = "glm-5.3-flash",      input_per_m = 0.15,  output_per_m = 0.50,  cache_read_per_m = 0.03 },
  # GLM-5.3 — Z.AI official card, released 2026-08-18 (1M context): $1.40 in / $4.40 out,
  # cached-input read $0.26/M. Storage listed free for now, no batch discount published.
  { prefix = "glm-5.3",            input_per_m = 1.40,  output_per_m = 4.40,  cache_read_per_m = 0.26 },
  # GLM-5.1 — Zhipu AI (≤200k context)
  { prefix = "glm-5.1",            input_per_m = 0.95,  output_per_m = 3.15  },
  # GLM-5 Turbo — Zhipu AI
  { prefix = "glm-5-turbo",        input_per_m = 0.95,  output_per_m = 3.15  },
  { prefix = "glm-5",              input_per_m = 0.95,  output_per_m = 3.15  },
  # Prefix rows: "zai" is the current attribution prefix; "zhipu" kept for
