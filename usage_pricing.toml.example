[providers.moonshot]
entries = [
  # Kimi K3.1 Pro (2026-10-23): $2.00/$10.00, cache read $0.20, 5m cache write $2.00.
  # Highspeed doubles input/output and cache writes; cached reads stay $0.20.
  # Its prefix drops the "kimi-" stem so it cannot swallow the pro row: matching
  # takes the longest overlap and breaks ties to the dearer card, so a prefix
  # that contains the plain id would price every K3.1 Pro call at the highspeed
  # rate. A bare "k3.1-pro" still ties and lands there, which over-states rather
  # than under-bills, and the test pins exactly that.
  { prefix = "k3.1-pro-highspeed",      input_per_m = 4.0,  output_per_m = 20.0,  cache_write_per_m = 4.0,  cache_read_per_m = 0.20 },
  { prefix = "kimi-k3.1-pro",           input_per_m = 2.0,  output_per_m = 10.0,  cache_write_per_m = 2.0,  cache_read_per_m = 0.20 },
  { prefix = "k3.1-pro",                input_per_m = 2.0,  output_per_m = 10.0,  cache_write_per_m = 2.0,  cache_read_per_m = 0.20 },
  # The 256K-context Kimi K3 variant bills the K3 card.
  { prefix = "k3-256k",                 input_per_m = 3.0,  output_per_m = 15.0,  cache_read_per_m = 0.30 },
  # Kimi K3 — Moonshot AI (256k context). Live model id is "k3", normalized to "kimi-k3".
  # Cache hit: $0.30/1M, cache miss (input): $3.00/1M, output: $15.00/1M. Cache-write not published.
  { prefix = "kimi-k3",              input_per_m = 3.0,   output_per_m = 15.0,  cache_read_per_m = 0.30 },
  # Kimi K2.6 — Moonshot AI (≤262k context)
  # Cache hit: $0.16/1M, Cache miss: $0.95/1M
  { prefix = "kimi-k2.6",            input_per_m = 0.95,  output_per_m = 4.0,   cache_write_per_m = 0.95, cache_read_per_m = 0.16 },
  { prefix = "kimi-k2-6",            input_per_m = 0.95,  output_per_m = 4.0,   cache_write_per_m = 0.95, cache_read_per_m = 0.16 },
  { prefix = "kimik2.6",             input_per_m = 0.95,  output_per_m = 4.0,   cache_write_per_m = 0.95, cache_read_per_m = 0.16 },
  { prefix = "kimi-k2.5",          input_per_m = 0.60,  output_per_m = 3.0   },
  { prefix = "kimi-k2-turbo",      input_per_m = 1.15,  output_per_m = 8.0   },
  { prefix = "kimi-k2",            input_per_m = 0.60,  output_per_m = 2.50  },
  { prefix = "kimi",               input_per_m = 0.60,  output_per_m = 2.50  },
]

