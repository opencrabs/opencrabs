# OpenCrabs Usage Pricing Table — usage_pricing.toml.example
#
# This file is copied to ~/.opencrabs/usage_pricing.toml on first run.
# Edit that file live — changes take effect immediately on next /usage open.
# No restart needed.
#
# Rules:
#   - `prefix` is matched as a case-insensitive substring of the model name
#   - First match within each provider wins — put specific prefixes before general ones
#   - Costs are per 1 million tokens (USD)
#   - Add any provider/model — if it's not here, cost is estimated at a
#     conservative default rate and marked ~ in /usage (#1717). Add an entry
#     for exact pricing.

[providers.anthropic]
entries = [
  # Claude Opus 5.5 (2026-09-22): $4/$20, cache write $5, cache read $0.20.
  # Short forms are the ids claude-cli and our ledger actually record.
  { prefix = "claude-opus-5-5",    input_per_m = 4.0,   output_per_m = 20.0,  cache_write_per_m = 5.0,   cache_read_per_m = 0.20 },
  { prefix = "opus-5-5",           input_per_m = 4.0,   output_per_m = 20.0,  cache_write_per_m = 5.0,   cache_read_per_m = 0.20 },
  { prefix = "opus-5",             input_per_m = 5.0,   output_per_m = 25.0,  cache_write_per_m = 6.25,  cache_read_per_m = 0.50 },
  { prefix = "opus-4",             input_per_m = 5.0,   output_per_m = 25.0,  cache_write_per_m = 6.25,  cache_read_per_m = 0.50 },
  # Claude Fable 5.1: $10/$50, 5m cache write $12.50, cache read $0.25 (0.025x input).
  { prefix = "claude-fable-5-1",   input_per_m = 10.0,  output_per_m = 50.0,  cache_write_per_m = 12.5,  cache_read_per_m = 0.25 },
  { prefix = "fable-5-1",          input_per_m = 10.0,  output_per_m = 50.0,  cache_write_per_m = 12.5,  cache_read_per_m = 0.25 },
  # Claude Sonnet 5.5 / Sonnet 5: $2/$10.
  { prefix = "claude-sonnet-5-5",  input_per_m = 2.0,   output_per_m = 10.0,  cache_read_per_m = 0.10 },
  { prefix = "claude-sonnet-5",    input_per_m = 2.0,   output_per_m = 10.0,  cache_read_per_m = 0.20 },
  # Claude Haiku 5.5: $0.10/$0.50 with cache read $0.01 for prompts up to 100K.
  # A prompt over 100K bills $0.50/$2.50, which no single row can express; the
  # <=100K card is the one nearly every call lands on.
  { prefix = "claude-haiku-5-5",   input_per_m = 0.10,  output_per_m = 0.50,  cache_read_per_m = 0.01 },
  { prefix = "haiku-5-5",          input_per_m = 0.10,  output_per_m = 0.50,  cache_read_per_m = 0.01 },
  { prefix = "haiku-4-5",          input_per_m = 1.0,   output_per_m = 5.0,   cache_read_per_m = 0.10 },
  { prefix = "claude-fable",       input_per_m = 10.0,  output_per_m = 50.0,  cache_write_per_m = 12.5,  cache_read_per_m = 0.25 },
  { prefix = "claude-opus-5",      input_per_m = 5.0,   output_per_m = 25.0,  cache_write_per_m = 6.25,  cache_read_per_m = 0.50 },
  { prefix = "claude-opus-4",      input_per_m = 5.0,   output_per_m = 25.0,  cache_write_per_m = 6.25,  cache_read_per_m = 0.50 },
  { prefix = "claude-3-opus",      input_per_m = 15.0,  output_per_m = 75.0  },
  { prefix = "claude-sonnet-4",    input_per_m = 3.0,   output_per_m = 15.0  },
  { prefix = "claude-3-7-sonnet",  input_per_m = 3.0,   output_per_m = 15.0  },
  { prefix = "claude-3-5-sonnet",  input_per_m = 3.0,   output_per_m = 15.0  },
  { prefix = "claude-3-sonnet",    input_per_m = 3.0,   output_per_m = 15.0  },
  { prefix = "claude-haiku-4",     input_per_m = 1.0,   output_per_m = 5.0   },
  { prefix = "claude-3-5-haiku",   input_per_m = 0.80,  output_per_m = 4.0   },
  { prefix = "claude-3-haiku",     input_per_m = 0.25,  output_per_m = 1.25  },
]

