# OpenCrabs Configuration File
# Copy this file to one of these locations:
#   - Linux/macOS: ~/.opencrabs/config.toml
#   - Windows: %APPDATA%\opencrabs\config.toml or opencrabs\config.toml
#
# IMPORTANT: API keys should NOT be stored here!
# Instead, store API keys in keys.toml (chmod 600) for security:
#   - ~/.opencrabs/keys.toml
# Keys in keys.toml take priority over this file.

[database]
# Database file location (stores conversation history)
# path = "~/.opencrabs/opencrabs.db"  # Default; only override if needed

[providers]
# NOTE on the `enabled` flag: `enabled = false` only removes a provider from the
# default-selection scan (new sessions pick the first enabled provider, in
# priority order). It does NOT disable the provider. By-name usage ignores the
# flag entirely: per-session provider restoration, /models switching, the
# [providers.fallback] chain, and the [image.vision] provider override can all
# still reach a provider marked enabled = false, and it works fine with an API
# key or an authenticated CLI on this machine. Think "not the default", not
# "dead".
# ========================================
# Built-in OpenCrabs
# ========================================
# No key to type. Onboarding asks the inference proxy for an install token and
# stores it in keys.toml ([providers.opencrabs] api_key). Enable it by choosing
# OpenCrabs in onboarding, not by hand. The proxy serves one model today.
[providers.opencrabs]
enabled = false
default_model = "cb/deepseek-v4.1-flash"
models = ["cb/deepseek-v4.1-flash"]
# context_window is not honoured here: the built-in endpoint is free and fixed
# at 200k, so any value set in this section is ignored.
vision_model = "cb/deepseek-v4.1-flash"  # Multimodal: attached images work on day 0
generation_model = "cb/gemini-2.5-flash-image"  # Image generation on day 0, served only on /v1/images/*
# No stt_model / tts_model here: the built-in endpoint serves no audio routes, so
# a preset would only turn every voice note into a refusal. Set them on a
# provider that exposes /v1/audio/transcriptions and /v1/audio/speech.

# ========================================
# Xiaomi MiMo
# ========================================
# OpenAI-compatible, keyed. Get an API key (sk-...) at platform.xiaomimimo.com
# and put it in keys.toml ([providers.xiaomi] api_key). With no key this section
# is skipped and onboarding prompts you for one.
#
# base_url is optional — it defaults to the official endpoint below. Models are
# fetched live from /v1/models (chat models only), so the /models picker shows
# what's actually available; the list here is just an offline fallback. Thinking
# is ON by default (the model streams its reasoning); set enable_thinking = false
# to turn it off. Prompt caching is automatic server-side — nothing to configure.
[providers.xiaomi]
enabled = false
# base_url = "https://api.xiaomimimo.com/v1"  # optional — this is the default
default_model = "mimo-v2.5-pro"
models = ["mimo-v2.5-pro", "mimo-v2-pro", "mimo-v2.5", "mimo-v2-omni", "mimo-v2-flash"]
context_window = 1000000  # compaction budget (auto-compacts at 65%/90%); default 200000; works on any provider
vision_model = "mimo-v2.5-pro"  # MiMo v2.5 is multimodal — analyze_image uses it natively (falls back to Gemini if image.vision is set)
# enable_thinking = false  # uncomment to disable the model's reasoning output
# force_default = true  # ENFORCE this provider's default pair on EVERY session.
#   By default a new default applies to NEW sessions only — existing/live
#   sessions keep their own provider+model. Set force_default = true on the
#   provider you want as the global default, and on config reload its
#   default_model pair is pushed to every non-archived session (only when this
#   section is the active default provider). Off/absent = new-sessions-only.

# ========================================
# Ollama Provider (Local + Cloud)
# ========================================
# Local: runs on localhost:11434 — no API key needed
# Cloud: set base_url to your Ollama Cloud endpoint + optional API key
# Models are fetched automatically from /api/tags
# Requires: ollama serve (local) or a cloud endpoint
[providers.ollama]
enabled = false
base_url = "http://localhost:11434/v1/chat/completions"
# default_model = "llama3.1"  # Optional: override default
# api_key = ""  # Optional: only needed for Ollama Cloud

# ========================================
# Custom: OpenAI-Compatible Provider (Local LLMs, and any OpenAI Compatible model)
# ========================================
# Use this for LM Studio, Ollama, LocalAI, etc.
# Every custom provider needs a name — the label after "custom." (e.g. lm_studio, nvidia, groq).
# You can define as many as you need and switch between them via /models.
# A custom endpoint defaults to the Chat Completions route; set wire_dialect = "responses"
# if the gateway serves /responses, or "auto" to probe Chat first and fall back on refusal.
[providers.custom.lm_studio]
enabled = false
base_url = "http://localhost:1234/v1/chat/completions"  # LM Studio default
models = ["kimi-k2.5", "glm-5", "MiniMax-M3", "qwen3-coder", "gpt-oss-120b", "llama-4-70B", "mistral-Large-3", "qwen3-coder-next"]

# ⭐ IMPORTANT: Set this to match the model name loaded in LM Studio!
# Common examples:
#   - qwen2.5-coder-7b-instruct
#   - codellama-7b-instruct
#   - deepseek-coder-6.7b-instruct
#   - llama-3.2-1b-instruct
default_model = "qwen3-coder-next"

# Other local LLM servers — just add another named section:
#
# [providers.custom.ollama]
# enabled = false
# base_url = "http://localhost:11434/v1/chat/completions"
# default_model = "mistral"
# models = ["mistral", "llama3", "codellama"]

# ========================================
# GitHub Copilot Provider
# ========================================
# Uses your GitHub Copilot subscription via OAuth device flow.
# Run /onboard:provider and select GitHub Copilot to sign in.
# base_url = "https://api.githubcopilot.com/chat/completions"
[providers.github]
enabled = false
default_model = "gpt-4o"
# Models are fetched live from the Copilot API

# ========================================
# Official OpenAI Provider
# ========================================
[providers.openai]
enabled = false
default_model = "gpt-5-nano"  # Optional: override default model
# wire_dialect = "auto"  # Optional: "auto" (Chat first, fall back to Responses when the model is refused), "chat" (always /chat/completions) or "responses" (always /responses). This host defaults to "auto".
# vision_model = "gpt-5-nano"  # Optional: describes images for the chat model when it lacks vision
# generation_model = "gpt-image-1"  # Optional: routes generate_image to OpenAI /v1/images/generations
# stt_model = "whisper-1"  # Optional: transcribe voice notes via this provider's /v1/audio/transcriptions
# tts_model = "gpt-4o-mini-tts"  # Optional: speak replies via this provider's /v1/audio/speech

# ========================================
# Anthropic Provider (Claude)
# ========================================
[providers.anthropic]
enabled = false
default_model = "claude-sonnet-4-6"  # Optional: override default

# ========================================
# OpenRouter Provider (100+ models via OpenAI-compatible API)
# ========================================
[providers.openrouter]
enabled = false
base_url = "https://openrouter.ai/api/v1/chat/completions"
default_model = "qwen/qwen3-coder-next"  # Many options at openrouter.ai/models

# ========================================
# OpenCode Provider (Go and Zen plans)
# ========================================
# Native API provider — no CLI subprocess needed.
# Models are fetched live from opencode.ai/zen/go/v1/models
# API key goes in keys.toml: [providers.opencode] api_key = "..."
# Get key from: opencode.ai/settings
[providers.opencode]
enabled = false
base_url = "https://opencode.ai/zen/go/v1/chat/completions"
# default_model = "qwen3.6-plus"  # Optional: override default

# ========================================
# Google Gemini Provider
# ========================================
# Models fetched live from the Gemini API during onboarding and /models
# API key goes in keys.toml under [providers.gemini]
# Get key from: aistudio.google.com
[providers.gemini]
enabled = false
default_model = "gemini-2.5-flash"
# generation_model = "imagen-4.0-generate-001"  # Optional: per-provider override for generate_image
# (Gemini host is detected automatically — call stays on the Gemini wire, not /v1/images/generations.)

# ========================================
# Claude CLI (Max Subscription — no API key needed)
# ========================================
# Spawns the local 'claude' CLI directly — uses your Claude Max subscription.
# No proxy, no API key. Just install Claude Code CLI and authenticate it.
# Install: npm install -g @anthropic-ai/claude-code
[providers.claude_cli]
enabled = false
default_model = "sonnet"  # "sonnet", "opus", or "haiku"

# ========================================
# Codex CLI (ChatGPT/Codex Subscription — no API key needed)
# ========================================
# Spawns the local 'codex' CLI directly — piggybacks on the auth stored in
# ~/.codex/auth.json by `codex login`. No proxy, no API key.
# Install: npm install -g @openai/codex   (then run `codex` once to sign in)
# Models per developers.openai.com/codex/models. gpt-5.5 is ChatGPT-auth only;
# fall back to gpt-5.4 if your account doesn't have 5.5 yet.
[providers.codex_cli]
enabled = false
default_model = "gpt-5.5"
models = [
    "gpt-5.5",
    "gpt-5.4",
    "gpt-5.4-mini",
    "gpt-5.3-codex",
    "gpt-5.3-codex-spark",
    "gpt-5.2",
]

# Command Code CLI — local `command-code` subprocess (also on PATH as `cmd`).
# Uses your Command Code account (~/.commandcode/auth.json from `command-code
# login`). No proxy, no API key.
# Install: npm install -g command-code   (then run `command-code login`)
# Models per `command-code --list-models` — full ids or the short name after
# the last `/` both work. Leave `models` unset to use the built-in list.
[providers.command_code_cli]
enabled = false
default_model = "deepseek/deepseek-v4-flash"
models = [
    "claude-sonnet-5",
    "claude-opus-4-8",
    "gpt-5.5",
    "google/gemini-3.5-flash",
    "deepseek/deepseek-v4-flash",
    "moonshotai/Kimi-K2.7-Code",
    "zai-org/GLM-5.2",
    "Qwen/Qwen3.7-Max",
]

# ========================================
# Codex (OAuth — no CLI needed)
# ========================================
# Authenticates directly with OpenAI Codex subscription via device-code
# OAuth flow. Tokens stored in ~/.opencrabs/auth/codex.json with automatic
# refresh. No `codex` CLI binary required — authenticate through the
# onboarding wizard (/onboard:provider).
# Uses the same public client ID as Codex CLI: app_EMoamEEZ73f0CkXaXp7hrann
[providers.codex]
enabled = false
default_model = "gpt-5.5"
models = [
    "gpt-5.5",
    "gpt-5.4",
    "gpt-5.4-mini",
    "gpt-5.3-codex",
    "gpt-5.3-codex-spark",
    "gpt-5.2",
    "gpt-4o",
    "o3",
    "o4-mini",
]

# ========================================
# Minimax Provider (Chinese AI, OpenAI-compatible)
# ========================================
# Note: Minimax does NOT have a /models endpoint, so add models manually
[providers.minimax]
enabled = false
base_url = "https://api.minimax.io/v1"
default_model = "MiniMax-M3"
models = ["MiniMax-M3", "MiniMax-M2.7", "MiniMax-M2.5", "MiniMax-M2.1", "MiniMax-Text-01"]
vision_model = "MiniMax-Text-01"  # Describes images for the chat model when it lacks vision

[providers.zai]
enabled = false
# endpoint_type = "coding"  # "api" (default) or "coding" for code-optimized endpoint
default_model = "glm-5.1"
models = ["glm-5.1", "glm-5-turbo", "glm-5", "glm-4.7", "glm-4.6", "glm-4.5", "glm-4.5-air"]
# API key goes in keys.toml: [providers.zai] api_key = "..."
# Get key from open.bigmodel.cn or z.ai

[providers.moonshot]
enabled = false
# endpoint_type = "coding"  # "api" (default, api.moonshot.ai) or "coding" (api.kimi.com, Kimi token subscription)
default_model = "k3"
models = ["k3", "kimi-for-coding", "kimi-for-coding-highspeed"]
# API key goes in keys.toml: [providers.moonshot] api_key = "..."
# API plan key from platform.moonshot.ai; Coding plan key from kimi.com

# ========================================
# Qwen / DashScope Provider (Alibaba Cloud Model Studio, OpenAI-compatible)
# ========================================
# DashScope OpenAI-compatible endpoints (use the one matching your API key's region):
#   - China (Beijing):  https://dashscope.aliyuncs.com/compatible-mode/v1
#   - Singapore (intl): https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   - US (Virginia):    https://dashscope-us.aliyuncs.com/compatible-mode/v1
#   - Alibaba Coding Plan (intl): https://coding-intl.dashscope.aliyuncs.com/v1
#   - Alibaba Coding Plan (CN):   https://coding.dashscope.aliyuncs.com/v1
# Regions are NOT interchangeable — match base_url to the region that issued your key.
# API key goes in keys.toml: [providers.qwen] api_key = "..."
# Get key from: bailian.console.aliyun.com (DashScope) or qwen.ai/apiplatform (Coding Plan)
[providers.qwen]
enabled = false
base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
default_model = "qwen3.6-plus"
models = [
    "qwen3.6-plus",
    "qwen3-max",
    "qwen3-coder-plus",
    "qwen3.5-plus",
    "qwen-max",
    "qwen-plus",
    "qwen-flash",
    "qwen-vl-max",
]
# enable_thinking = true  # opt-in to Qwen3 hybrid thinking mode

# ========================================
# Fallback Providers (automatic failover)
# ========================================
# When the primary provider fails, try these in order.
# Each must already have API keys configured in keys.toml.
# Supports single or multiple fallbacks.
[providers.fallback]
enabled = false
providers = ["openrouter", "anthropic"]  # Tried in order on failure
# provider = "openrouter"               # Legacy: single fallback (use providers array instead)

# Vision provider priority — overrides the default REGISTRATIONS scan
# order for the analyze_image tool.  Each entry is a provider name
# (e.g. "minimax", "anthropic").  Resolution order:
#   1. This list (first enabled match with vision_model wins)
#   2. All enabled providers in REGISTRATIONS priority order
#   3. Custom providers
#   4. Gemini [image.vision] fallback
# Empty or absent = scan all providers as before.
# vision = ["minimax", "anthropic"]

# Image-generation provider priority (#1672) — ordered chain tried by
# generate_image after the session's current provider. Each entry is a
# provider name (e.g. "openrouter", or the key of a [providers.custom.<name>]
# section); the model is that provider's `generation_model`, endpoints are
# derived and never guessed. The global Gemini [image.generation] section
# stays the LAST resort and is the only leg gated by its `enabled` flag.
# generation = ["qwen-image", "openrouter"]

# ========================================
# STT (Speech-to-Text) Providers
# ========================================
# Groq Whisper for transcription
[providers.stt.groq]
enabled = false
default_model = "whisper-large-v3-turbo"

# OpenAI-compatible STT (self-hosted Whisper, Together AI, etc.)
[providers.stt.openai_compatible]
enabled = false
base_url = "http://localhost:11434"        # Ollama, LM Studio, or any OpenAI-compatible STT
model = "whisper-large-v3-turbo"

# Voicebox STT (local voice-to-text service)
[providers.stt.voicebox]
enabled = false
base_url = "http://localhost:8000"

# ========================================
# TTS (Text-to-Speech) Providers
# ========================================
# OpenAI TTS for voice output
[providers.tts.openai]
enabled = false
default_model = "gpt-4o-mini-tts"
voice = "ash"             # TTS voice name
model = "gpt-4o-mini-tts" # TTS model

# OpenAI-compatible TTS (self-hosted, Together AI, etc.)
[providers.tts.openai_compatible]
enabled = false
base_url = "http://localhost:11434"
model = "tts-1"
voice = "alloy"

# Voicebox TTS (local voice-to-text service)
[providers.tts.voicebox]
enabled = false
base_url = "http://localhost:8000"
profile_id = ""

# ========================================
# Image Generation & Vision (Google Gemini)
# ========================================
# API key goes in keys.toml under [image]
# Get key from: aistudio.google.com
# Use /onboard:image to configure via wizard

# ========================================
# Cron Job Defaults
# ========================================
# Default provider/model for cron jobs that don't specify their own.
# Priority: per-job --provider > [cron] default > session's active provider.
# Useful for routing cron jobs to a cheaper provider.
[cron]
# default_provider = "minimax"
# default_model = "MiniMax-M3"

# ========================================
# Tiered decision cache (#1648)
# ========================================
# A tier is a decision-shaped question worth reusing answers for.
# Shadow mode (the default) changes nothing the agent experiences: it
# only counts identical repeat decisions as would-hits so a deployment
# can decide keep-or-cut with data. Set mode = "live" per tier to
# actually reuse cached decisions; mode = "off" disables a tier.
# policy_version is required; bump it whenever the semantics of the
# tier's answer change, which keys every old row out.
# [decisions.tiers.triage]
# policy_version = "p1"
# mode = "shadow"
# ttl_hours = 168
# margin_floor = 0.2

# ========================================
# Agent / Sub-Agent Defaults
# ========================================
# Default provider/model for the main chat session.
# When set, new sessions inherit these values instead of the most recent session's provider/model.
# Existing sessions pick up the new defaults on next resume (via sync_provider_for_session).
# Useful for enforcing a specific model across all sessions without manual /models switching.
# Priority: agent defaults > most recent session > config active provider.
[agent]
# Tool-approval policy (default: "auto-always"). OpenCrabs ships tools that run
# unattended so you are not asked to approve every step, which is the point of
# an autonomous agent. If you would rather confirm each tool call, set this to
# "ask" and OpenCrabs prompts before every tool that declares it needs approval:
#   approval_policy = "ask"
# "auto-session" approves for the current session only. Note that channel
# allowlists are the access boundary: only the owner and allow-listed users can
# drive tools at all, so a stranger cannot reach this policy (an unconfigured
# channel denies everyone).
# approval_policy = "auto-always"

# context_limit = 200000  # Context window in tokens (default: 200000)
# default_provider = "xiaomi"
# default_model = "mimo-v2.5-pro"
# subagent_provider = "zhipu"
# subagent_model = "GLM 5"
# Days to keep a spawned sub-agent's session before it is pruned, with its
# messages, tool executions and plan files. 0 keeps them forever. They are
# always hidden from the session list; this only decides when they are removed.
# subagent_session_ttl_days = 7

# Lazy tool-schema loading (default: true — RECOMMENDED). Each request ships
# only the CORE tool schemas (~4k tokens) plus `tool_search`. The agent calls
# `tool_search("what I need")` to discover and activate the extended tools
# (browser, channels, sub-agents, media, system) on demand — they then ride on
# subsequent requests for the session. We recommend leaving this on: load only
# the core set and let the agent pull the rest as needed.
#
# Setting `lazy_tools = false` reverts to sending the FULL tool-schema set —
# ALL ~95 tools (~20k tokens) — in EVERY single request, whether the turn uses
# them or not. That overhead is counted by the provider on every call (real
# cost, not just display). Only set false if a model in your setup struggles
# to reach for `tool_search`.
# lazy_tools = false

# Skill glob gate (default: true). When a SKILL.md declares a `globs:`
# frontmatter field, tool calls touching a path matching one of those globs
# are rejected until the skill body is loaded in the current session context
# (fresh sessions AND after compaction). The rejection carries the full skill
# body; the identical retry then succeeds. Per-skill opt-out: delete the
# skill's `globs` key. Set false to disable the gate entirely.
# skill_glob_gate = true

# Provider/model for Recursive Self-Improvement (RSI) cycles. The model is
# paired with the provider, same as subagent_provider/subagent_model.
# Unset self_improvement_provider → inherit the active provider; unset
# self_improvement_model → use that provider's default model.
# Scope: these keys drive ONLY the built-in RSI engine. RSI scheduled as a
# cron job runs on the provider/model stored in the cron row itself, and
# these keys are dormant there.
# self_improvement_provider = "zhipu"
# self_improvement_model = "glm-5.1"

# Master switch for the RSI autonomous engine (#1063). Unset → ON for the
# interactive TUI, OFF for headless daemons (unattended hourly cycles with
# auto-approved tools are quota burn, not a feature). Set explicitly to
# override for your install; edits apply on the next cycle, no restart.
# rsi_enabled = true

# Auto-install new releases on startup (default: true).
# When true, OpenCrabs checks GitHub on startup and silently installs any
# new release, then hot-restarts. Set to false if you prefer to be prompted
# before each update (or to /evolve manually). Every downloaded binary is
# verified against the release's published SHA256SUMS before it is swapped in,
# so a tampered or wrong-host asset is refused regardless of this setting.
# auto_update = true

# Allow an auto-update or /evolve binary swap while running as root (default:
# true). Left true so a root daemon keeps updating and a forgotten flag never
# silently breaks updates. Set false to refuse root swaps; a root binary swap
# means a compromised release would run as root, so a security-conscious
# operator may prefer to run the daemon under a non-root user.
# evolve_allow_root = true

# Redact sensitive data from tool outputs and display (default: true).
# When true, API keys, tokens, passwords, and IP addresses are redacted
# from tool call displays and outputs. Set to false during sysadmin/devops
# work where seeing IPs, tokens, and passwords is necessary.
# redact_sensitive_data = false

# Enable debug file logging from config, on top of the `--debug` CLI flag.
# Lets you (or the agent, on request) turn detailed logs in ~/.opencrabs/logs/
# on or off by flipping this to true/false. The change hot-reloads with no
# restart. Effective state is `--debug OR debug_logs`, so the flag always wins.
debug_logs = false

# Thinking-loop guard in seconds (#890, scoped and disarming per #1690). How
# long a model may stream without emitting a single tool call. Catches the
# failure mode where a reasoning model loops internally (thinking tokens
# flowing, 0 tool calls) for an hour or more. Default 600 = 10 min.
#
# A stream that is still DELIVERING chunks is not cut: the guard stands itself
# down and lets the answer finish, because discarding in-flight content and
# replaying the whole conversation was the worse bug. Only a stream that has
# delivered nothing is killed and retried with multi-language phantom
# enforcement. Inter-chunk silence stays governed by stream_idle_timeout_secs.
#
# `[agent]` is the global tier; any provider may override it with
# `thinking_loop_timeout_secs` in its own `[providers.<name>]` section (#1690),
# which is the knob to reach for when one long-reasoning model needs 900s and
# the rest of the fleet should keep the default.
# Set to 0 to disable. Hot-reloads with no restart.
thinking_loop_timeout_secs = 600

# Global non-streaming request ceiling, in seconds (#1688, #1689). The fallback
# for `[providers.<name>].timeout_secs`: a provider naming no value of its own
# inherits this one, and if neither is set the family's compiled 300s applies.
# Every family honours it — OpenAI-compatible and custom providers, anthropic,
# gemini.
# Like the per-provider key, it has NO effect on streaming — streams run on an
# HTTP client built without a total timeout, so a healthy long turn is never cut
# by a wall clock (#1687). Unset by default.
#timeout_secs = 120

# Global inter-chunk streaming inactivity timeout, in seconds (#1688). The
# fallback for `[providers.<name>].stream_idle_timeout_secs`, and the only timer
# a stream ever meets. Deliberately no compiled default: silence tolerance is
# picked at stream time (3600s for CLI and local providers, 45s for z.ai on
# api.z.ai, 20s for every other remote), so leaving this unset defers to that
# runtime choice instead of overriding it.
#stream_idle_timeout_secs = 45

# Cadence (in seconds) for injecting periodic wall-clock notices during
# long-running tool execution turns. Keeps autonomous multi-step loops
# grounded without stale time drift or prompt-cache busting. Default: 900 (15 min).
# Set to 0 to disable intra-turn periodic markers while retaining turn-ingress time.
time_marker_interval_secs = 900

[image.generation]
enabled = false
model = "gemini-3.1-flash-image-preview"   # Gemini image-gen model ("Nano Banana")
# Override the model per-provider by setting `generation_model` under
# `[providers.<name>]` — e.g. `imagen-4.0-generate-001` on gemini, or
# `gpt-image-1` / `black-forest-labs/flux-1.1-pro` / `qwen-image` on any
# OpenAI-compatible provider (openai, openrouter, DashScope-backed custom
# sections, …). Provider candidates are tried in order: the session's
# current provider first, then `[providers.fallback] generation` above;
# the backend wire is picked automatically (Gemini host → Gemini API,
# anything else → `/v1/images/generations` with Bearer auth). This
# `enabled` flag gates ONLY the global Gemini fallback below — a provider
# route registers generate_image even with it off (#1672).
#
# Voice works the same way: set `stt_model` and `tts_model` on your active
# [providers.<name>] block and voice notes transcribe and replies speak on
# that provider's own endpoint. Any [OI]-compatible provider works, built-in
# or custom, as long as its endpoint exposes `/v1/audio/transcriptions` and
# `/v1/audio/speech`; the built-in OpenCrabs provider does not expose them
# yet. `stt_model` drives `transcribe`, `tts_model` drives `synthesize`; no
# `[providers.stt.*]` / `[providers.tts.*]` block is needed when the active
# provider carries them.

# ========================================
# Vision setup — two paths, pick one
# ========================================
#
# Path A (preferred, simpler): set `vision_model = "<model>"` on your
# active [providers.<name>] block above. Works for every built-in and
# custom provider. The agent calls the vision model on the SAME
# provider endpoint via the `analyze_image` tool, so no second API key
# is needed. Pick a vision-capable model on that provider — DeepSeek
# chat models like `deepseek-v4-flash` reject image_url content, so
# point `vision_model` at a vision-capable variant of the same family
# (every provider has at least one).
#
# Path B (fallback): enable Gemini globally below. Use this only when
# your active provider has no vision-capable model.
#
# IMPORTANT: the api_key for vision must be set in `keys.toml`
# `[image]` section, NOT here. The api_key field on `[image.vision]`
# carries `#[serde(skip)]` and is silently dropped on load — put it in
# keys.toml or it will look enabled but produce zero vision calls.
#
# When vision is unavailable for any reason, `is_vision_available`
# now logs the exact reason at INFO level in
# `~/.opencrabs/logs/opencrabs.YYYY-MM-DD` — search for `target=vision`.
#
# Easiest setup: run `/onboard:image` and it walks you through Gemini.

[image.vision]
enabled = false
model = "gemini-3.1-flash-image-preview"   # Gemini vision model

# ========================================
# Browser automation (feature: browser)
# ========================================
# By default each profile launches its own headless Chromium (~250-300MB each).
# To share ONE Chromium across multiple profiles (big memory win on small VDS),
# start a standalone instance with remote debugging:
#
#   chromium --remote-debugging-port=9222 --headless --no-sandbox
#
# then point every profile's config at it. Prefer the http:// form — OpenCrabs
# queries /json/version to find the real devtools websocket URL. (A bare
# ws://host:port is also accepted and normalized to http:// automatically.)
# [browser]
# cdp_endpoint = "http://localhost:9222"

# ========================================
# Tips for Using Local LLMs
# ========================================
# 1. Make sure LM Studio is running before starting OpenCrabs
# 2. Load a model in LM Studio first
# 3. Set default_model to EXACTLY match the model name shown in LM Studio
# 4. Increase context length in LM Studio if you get overflow errors:
#    - Recommended: 8192 or higher
#    - Location: LM Studio > Model Settings > Context Length

# ==================================================
# Channels (Telegram / WhatsApp / Slack / Discord / Trello)
# ==================================================

# respond_to controls which messages the bot replies to (applies to Telegram, Discord, Slack):
#   "all"      — reply to every message in allowed channels (default)
#   "dm_only"  — reply only to direct/private messages
#   "mention"  — reply only when the bot is @mentioned or replied-to
#   "auto"     — reply to all while there is at most one active sender, then switch
#                to mention-only once a second unique sender appears in the chat

[channels.whatsapp]
enabled = false
# You pair the bot to a WhatsApp account by scanning its QR — it then runs AS
# that account. It can be your own number (talk to it in "Message Yourself") or
# any other number you own, including a WhatsApp Business account, to serve that
# account's incoming DMs.
# Phone numbers allowed to message the bot (E.164 format, leading + optional)
# allowed_phones = ["+15551234567"]
# bot_owner = ["+15551234567"]          # Operator phone(s) for owner-only commands. The operator can DM the
                                        # bot and is always allowed regardless of response_policy. Auto-seeded
                                        # from the first allowed_phones entry on first run; set explicitly to
                                        # pin a different operator than the paired account.
# response_policy = "auto"              # Who the bot answers. The paired account's own self-chat and bot_owner
                                        # are ALWAYS allowed. Options:
                                        #   "auto"       — legacy: open when allowed_phones is empty, else
                                        #                  owner/operator + allowed_phones (default)
                                        #   "owner_only" — only the paired self-chat and bot_owner operators
                                        #   "allowlist"  — owner/operator + the contacts in allowed_phones
                                        #   "open"       — every incoming DM (business serving any customer)
# session_idle_hours = 24.0             # Archive inactive non-owner sessions after N hours (default: never)

[channels.discord]
enabled = false
allowed_channels = ["channel_id"]       # Where the bot operates (empty = all channels)
# allowed_users = [123456789012345]        # Who the bot replies to (numeric user ID, empty = everyone)
# bot_owner = [123456789012345]         # Owner ID(s) for owner-only commands. Auto-seeded from the first
                                        # allowed_users entry on first run; set explicitly to pin the owner.
# respond_to = "all"                    # "all" | "dm_only" | "mention"
# session_idle_hours = 24.0             # Archive inactive non-owner sessions after N hours (default: never)
# trace_narration = true                # Fold intermediate narration (model text between tool
                                        # calls) into the turn's tool-group bubble as dim subtext
                                        # instead of posting each as a separate message.
                                        # Default: true. Set false to post each intermediate as
                                        # its own message.
# Slash commands are projected from commands.toml (no knob needed). The bot needs
# the "applications.commands" OAuth2 scope at invite time, not just "bot": without
# it the gateway connects and chat works, but every command registration returns
# 403 and "/" stays empty. See src/docs/reference/DISCORD_COMMANDS.md.

# Outbound write governor (#1910): one token bucket per channel, applied before
# the write goes out, plus a park learned from a 429. Discord publishes no fixed
# per-route budget, so these are ceilings that only bite when the bot outruns its
# own cadence, not a mirror of the API's limits.
# [channels.discord.governor]
# enabled = true                        # Master switch. false = pre-#1910 pass-through.
# writes_per_minute = 40                # Rolling per-channel write ceiling. 0 = no ceiling.
# burst = 12                            # Headroom before the sustained rate starts pacing.
# chrome_min_spacing_ms = 1000          # Spacing between LIVE re-renders (ticker clock,
                                        # waiting line). Content writes and sends never wait
                                        # on it. 0 = no spacing.
# pause_secs = 5                        # Fallback park when a 429 names no retry_after, and
                                        # the ceiling on a park that does (4x this value).

[channels.telegram]
enabled = false
# allowed_users = [123456789]             # Who the bot replies to (numeric user ID, empty = everyone)
# bot_owner = [123456789]               # Owner ID(s): owner-only commands (e.g. /cd) and gated actions.
                                        # Auto-seeded from the first allowed_users entry on first run; set it
                                        # explicitly to pin the owner instead of relying on list order.
# allowed_channels = ["-100123456789"]  # Chat/group IDs to restrict to (empty = all chats)
# respond_to = "all"                    # "all" | "dm_only" | "mention" | "auto"
# silence_group_start = true            # Silently ignore /start from non-allowed users in groups (default: true)
# session_idle_hours = 24.0             # Archive inactive non-owner sessions after N hours (default: never)
# rich_messages = true                  # Native rich messages — flow logs, collapsible tool calls,
                                        # status bubble with task preview. Default: true since v0.3.64.
                                        # Toggle available in the onboard dialog (/onboard:provider →
                                        # Telegram channel step). Set to false if your audience uses
                                        # Telegram Web or older clients (no HTML fallback).

# Proactive flood governors (#1211): per-forum token buckets applied BEFORE the
# Bot API answers 429, layered beside the reactive Retry-after backoff. Three
# independent governors keyed by forum chat id:
#   G1 typing  — ~1 sendChatAction / 3 s per CHAT (burst 8); the bucket is
#                keyed on the chat id alone, so concurrent sessions and
#                separate topics in one group share it. Refreshes held past
#                typing_max_hold_secs are dropped. At the 3 s default the
#                sustained rate is 60/3 = 20/min, which is exactly Telegram's
#                documented per-group ceiling: raise it to leave headroom.
#                Measured 2026-09-29/30 (#697): cutting typing 89 % (3 s → 30 s)
#                left the refusal rate unchanged, so this knob is NOT the 429
#                lever; the trigger is the sub-second interval between
#                requests, not any per-minute ceiling.
#   G2 edits   — ~18 editMessageText / min per chat (edits_per_minute); when the
#                budget is empty a priority drop ladder sheds clock → brain
#                preview → intermediary flow updates → status line (each
#                self-heals on the next full render). Finals never drop: settle
#                renders and plan-card refreshes queue latest-wins per message
#                until budget refills.
#   G3 sends   — full messages paced ~1/s per chat under an 18/min group
#                ceiling (burst 5); pacing delays, it never drops (#297).
#   G5 floor   — cross-surface minimum spacing between ANY two admissions to
#                one chat (#1927), charged ahead of the four governors above:
#                Telegram's per-chat rule is sub-minute, which a per-minute
#                bucket cannot express. 0 disables it.
# Enforcement is FORUMS-ONLY: a chat becomes governed once any call is seen
# carrying a topic id; DMs are untouched. Telemetry lands in one periodic INFO
# line per active chat ("Telegram rate-limiter chat=…").
# [channels.telegram.rate_limiter]
# enabled = true                        # Master switch. Default: true.
# typing_min_interval_secs = 3          # G1 spacing per chat: rate = 60 / this.
# typing_burst = 8                      # G1 burst capacity.
# typing_max_hold_secs = 30             # G1 longest hold before dropping.
# edits_per_minute = 18                 # G2 steady-state edit budget (sized under ~20/min group limit).
# edit_burst = 10                       # G2 burst capacity.
# send_min_interval_millis = 1000       # G3 spacing between sends (~1/s).
# sends_ceiling_per_minute = 18         # G3 group ceiling (official ~20/min).
# sends_burst = 5                       # G3 burst capacity.
# rich_per_minute = 18                  # G4 steady-state rich budget.
# rich_burst = 10                       # G4 burst capacity.
# spacing_floor_ms = 1000               # G5 cross-surface floor (#1927); 0 disables.
# summary_log_secs = 300                # Telemetry summary line spacing.
# [channels.telegram.userbot]
# enabled = false
# allowed_chats = ["-1001234567890"]   # Empty = dry mode; passive text capture only.
# session_path = "sessions/telegram_userbot.json" # Relative paths resolve under the active profile.
# Login after placing api_id/api_hash/phone in keys.toml:
# opencrabs channel userbot-login

# Per-group access control (per-chat ACL). Tiers:
#   - allowed_users (above) = admins: may DM the bot and act in any chat.
#   - bot_owner             = owner: always allowed everywhere.
#   - groups.<chat_id>.allowed_users = users allowed in THAT group ONLY. They are
#     refused in DMs unless they are also an admin/owner — this blocks the "DM the
#     bot privately to escape group oversight" bypass.
# DMs are gated to admins + owner. If neither allowed_users nor bot_owner is set
# the bot is unconfigured and stays open (no hard lockout); set either to lock down.
# Each group may also override respond_to just for that group.
# [channels.telegram.groups.-1001234567890]
# allowed_users = [222333444, 555666777]  # allowed in this group only, never via DM
# respond_to = "mention"                  # per-group override of the global respond_to

[channels.slack]
enabled = false
allowed_channels = ["C12345678"]        # Where the bot operates (Slack channel ID, empty = all)
# allowed_users = ["U12345678"]           # Who the bot replies to (Slack user ID, empty = everyone)
# bot_owner = ["U12345678"]             # Owner ID(s) for owner-only commands. Auto-seeded from the first
                                        # allowed_users entry on first run; set explicitly to pin the owner.
# respond_to = "all"                    # "all" | "dm_only" | "mention"
# session_idle_hours = 24.0             # Archive inactive non-owner sessions after N hours (default: never)

# Outbound write policy for Slack (#2012), the twin of [channels.discord.governor]
# (#1910). slack-morphism's own throttler stays underneath: it queues the request
# and retries it, it does not know that this request is the fourth re-render of a
# step group nobody has read yet. Content (answers, notices, settle stamps) is
# delay-never-drop; chrome (the flow ticker's clock, the step-group status edit)
# is dropped the moment it is refused, because the next paint restates it.
# [channels.slack.governor]
# enabled = true                        # Master switch. false = pre-#2012 pass-through.
# writes_per_minute = 50                # Rolling per-conversation write ceiling. 0 = no ceiling.
# burst = 10                            # Headroom before the sustained rate starts pacing.
# chrome_min_spacing_ms = 1000          # Spacing between LIVE re-renders (ticker clock,
                                        # step-group status). Content writes and sends never wait
                                        # on it. 0 = no spacing.
# pause_secs = 5                        # Fallback park when a 429 names no Retry-After, and
                                        # the ceiling on a park that does (4x this value).

# ========================================
# Trello — board card management
# ========================================
# API keys/tokens go in keys.toml under [channels.trello]
# Default mode: tool-only — no automatic polling. The AI acts on Trello only
# when you explicitly ask it to via trello_send / trello_connect.
# Opt-in polling: set poll_interval_secs > 0 to have the agent watch boards
# for @mentions of the bot username and respond to them.
[channels.trello]
enabled = false
# Board IDs or names to monitor — you can mix 24-char hex IDs and human-readable board names.
# The agent resolves names at startup. Comma-separated in the wizard; TOML array here.
board_ids = ["your-board-name", "abc123def456abc123def456"]
allowed_users = []                      # Trello member IDs allowed to @mention the bot (empty = all)
# bot_owner = ["member_id"]             # Owner ID(s) for owner-only commands. Auto-seeded from the first
                                        # allowed_users entry on first run; set explicitly to pin the owner.
# poll_interval_secs = 30              # Opt-in: poll boards every N seconds for @mentions. Default = disabled.
# session_idle_hours = 24.0             # Archive inactive non-owner sessions after N hours (default: never)

# ========================================
# Daemon Mode (systemd / launchd service)
# ========================================
# Settings for `opencrabs daemon` headless mode.
[daemon]
# HTTP health check port. When set, GET /health returns 200 OK + JSON.
# Useful for systemd watchdog, uptime monitors, and external health probes.
# health_port = 8080

# ========================================
# Agent-to-Agent (A2A) Protocol
# ========================================
# Enables HTTP gateway for peer-to-peer agent communication.
# Other A2A-compatible agents can send tasks, collaborate, and debate.
#
# The section is [a2a]. Older configs spell it [gateway] and still load — both
# names configure this one feature, and a file carrying both is folded into one
# rather than rejected. New configs should use [a2a] only.
[a2a]
enabled = false
bind = "127.0.0.1"     # Loopback only by default for security
port = 18790            # A2A gateway port
# CORS allowed origins (empty = no cross-origin requests allowed)
# allowed_origins = ["http://localhost:3000"]
# API key for Bearer token auth on /a2a/v1 (optional, recommended for non-loopback)
# Can also be set in keys.toml under [a2a] api_key = "..."
# api_key = "your-secret-key"

# ========================================
# Web Search Providers (default to free Duck Duck Go, no need additional web search provider)
# ========================================

[providers.web_search.exa]
enabled = true
# MCP is enabled by default as its free. If want through API its free up to 1000 requests. API key goes in keys.toml: [providers.web_search.exa] api_key = "..."

# Duck Duck Go needs no section of its own: it is built into web_search,
# always available and free. A table for it is not part of the schema, so one
# here would be discarded and reported back as an unrecognized config key.

[providers.web_search.brave]
enabled = false
# Its free up to 1000 requests. API key goes in keys.toml: [providers.web_search.brave] api_key = "..."

# Serper (Google SERP via serper.dev, #1731): paid per-query, 2500 free
# starter credits. Flip enabled = true AND put the key in keys.toml
# ([providers.web_search.serper] api_key = "...") to add Google results
# to the web_search fan-out. Supports gl/hl locale targeting per query.

# ========================================
# Memory / Embeddings
# ========================================
# Controls vector embeddings for semantic memory search.
# OFF by default (#1798): the local GGUF engine aborts on VPS and
# Windows hosts mid-index, so embeddings are opt-in. When disabled,
# only FTS5 (keyword) search is used: no model download, no llama.cpp
# init, zero GPU/CPU overhead.
#
# Set vector_enabled = true on capable machines (Apple Silicon, most
# Linux desktops). Startup detection also writes an explicit false on
# VPS/cloud as a safety net.
#
# [memory]
# vector_enabled = true

# --------------------------------------------
# External Index Paths (knowledge base)
# --------------------------------------------
# Index directories of markdown/text OUTSIDE your profile into memory search.
# Search them with memory_search scope="external" — answers come back as
# ranked excerpts with file paths, quotable verbatim.
#
# Each entry is a bare path string or a { path, pattern } table.
# Relative paths resolve against the OpenCrabs home (not the session cwd).
#
# Tip: pair with web_scrape sitemap export to index an entire docs site:
#   web_scrape url="https://docs.example.com" mode=sitemap export=true
# then point extra_paths at the scrapes/ directory. Zero AI/API cost.
#
# [memory]
# extra_paths = [
#   "~/knowledge/product-docs",
#   { path = "scrapes/docs.example.com", pattern = "**/*.md" },
# ]
# # exclude = ["**/node_modules/**"]          # extra global excludes (secrets/VCS are excluded by default)
# # external_allowed_in_shared = false         # default: external results are owner-session-only
# # sweep_interval_secs = 300                  # freshness sweep interval; changed files also caught lazily at search time

# --------------------------------------------
# OpenAI-compatible Embedding API
# --------------------------------------------
# When configured, embeddings are generated via API instead of the local
# GGUF model (embeddinggemma-300M). This eliminates the ~300MB model
# download and ~2.9GB RAM overhead of llama.cpp.
#
# Supports any OpenAI-compatible /v1/embeddings endpoint:
# OpenAI, Ollama, LM Studio, localai, Jina, etc.
#
# Example: OpenAI
# [memory.embedding]
# url = "https://api.openai.com/v1"
# model = "text-embedding-3-small"
# # api_key goes in keys.toml: [providers.memory_embedding] api_key = "sk-..."
# # dimensions = 1536   # auto-detected from first API response if unset
#
# Example: Ollama (local, free)
# [memory.embedding]
# url = "http://localhost:11434/v1"
# model = "nomic-embed-text"
#
# Example: Jina
# [memory.embedding]
# url = "https://api.jina.ai/v1"
# model = "jina-embeddings-v3"
# # api_key goes in keys.toml
